# ========================================================
# LearnMind AI — Backend Environment Configuration
# ========================================================

# Brevo (formerly Sendinblue) Transactional Email API Key
# 1. Sign up or log in at https://app.brevo.com/
# 2. Go to: Senders, Domains & Dedicated IPs -> Senders -> Add a sender (e.g. your Gmail)
# 3. Verify your sender email address (click the link in the confirmation email Brevo sends)
# 4. Go to: SMTP & API -> API Keys -> Generate a new API key
# 5. Copy your API key and paste it below:
BREVO_API_KEY=xkeysib-your_real_brevo_api_key_here

# Your verified Brevo sender email address (MUST match the verified sender in your Brevo account)
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

# Sender display name shown in email clients
BREVO_SENDER_NAME=LearnMind AI
