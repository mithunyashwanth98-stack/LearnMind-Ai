# ========================================================
# LearnMind AI — Backend Environment Configuration
# ========================================================

# Brevo (formerly Sendinblue) Configuration
# Supports both SMTP Relay (xsmtpsib-...) and REST API v3 (xkeysib-...)

# Brevo SMTP Key (xsmtpsib-...) or REST API Key (xkeysib-...)
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key_here
BREVO_API_KEY=xsmtpsib-your_brevo_smtp_key_here

# Brevo SMTP Server and Port (defaults: smtp-relay.brevo.com:587)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Your Brevo account login email (found in Brevo under 'SMTP & API' -> 'Login')
BREVO_SMTP_LOGIN=your_brevo_account_email@gmail.com

# Verified sender email address (shown as From address)
BREVO_SENDER_EMAIL=your_brevo_account_email@gmail.com

# Sender display name shown in email clients
BREVO_SENDER_NAME=LearnMind AI

# ========================================================
# Google Gemini AI Configuration
# ========================================================
# Generate your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini model (default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

